# Flask Session Key
FLASK_SECRET_KEY=super-secret-flask-key-change-me

# PostgreSQL Connection String (Neon / Supabase / Railway / Local Postgres)
# Leave empty or omit to fallback to local SQLite for rapid local testing
DATABASE_URL=postgresql://user:password@ep-cool-forest-123456.ap-southeast-1.aws.neon.tech/myshop?sslmode=require

# Cloudflare R2 Object Storage Configuration
# If unconfigured, image uploads fallback gracefully to local /static/uploads/
R2_ACCOUNT_ID=your_cloudflare_32_char_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=myshop-products
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Bakong KHQR Merchant Configuration
BAKONG_TOKEN=your_bakong_jwt_token_here
BAKONG_ACCOUNT_ID=myshop@aclb
MERCHANT_NAME=MyShop Cambodia
MERCHANT_CITY=Phnom Penh
STORE_LABEL=MyShop Online
MERCHANT_PHONE=85512345678
CURRENCY=USD

# Optional: Custom Relay URL if hosting outside Cambodia (Geo-IP restriction bypass)
KHQR_RELAY_BASE_URL=

# Demo Mode (enables safe simulation button on payment page for evaluations)
DEMO_MODE=true
